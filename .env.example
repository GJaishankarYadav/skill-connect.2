# PostgreSQL connection (never put real passwords in .env.example; set them in .env or host Secrets).
# For Supabase Session Pooler: SQL_HOST=aws-0-<region>.pooler.supabase.com, SQL_USER=postgres.<project-ref>, SQL_DB_NAME=postgres
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=

# Used by Drizzle Kit when applying the schema (for Supabase use postgres or postgres.<project-ref>).
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Required for external PostgreSQL hosts such as Supabase:
# SQL_PORT=5432
# SQL_SSL=true

# Optional. Restrict this key to your app's domains in Google Cloud.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
