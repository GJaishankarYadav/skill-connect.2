# PostgreSQL connection. Use the values from your Render PostgreSQL database.
SQL_HOST=
SQL_DB_NAME=
SQL_USER=
SQL_PASSWORD=

# Used by Drizzle Kit when applying the schema.
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Optional. Restrict this key to your app's domains in Google Cloud.
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
