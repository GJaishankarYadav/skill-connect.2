{
  "entities": {
    "Admin": {
      "title": "Admin",
      "description": "Authorized SkillConnect administrator record.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "role": {
          "type": "string",
          "enum": ["admin"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "name", "email", "role", "createdAt"]
    },
    "UserPii": {
      "title": "UserPii",
      "description": "Isolated participant personally identifiable information.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "age": {
          "type": "integer"
        },
        "gender": {
          "type": "string",
          "enum": ["Female", "Male", "Other", "Prefer not to say"]
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 300
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "fullName", "age", "gender", "phone", "email", "address", "updatedAt"]
    },
    "Workshop": {
      "title": "Workshop",
      "description": "Community skill workshop offering.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "category": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "duration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "workshopDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "capacity": {
          "type": "integer"
        },
        "registeredCount": {
          "type": "integer"
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "enum": ["open", "closed", "cancelled"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "name",
        "category",
        "description",
        "duration",
        "workshopDate",
        "startTime",
        "capacity",
        "registeredCount",
        "location",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "Session": {
      "title": "Session",
      "description": "Scheduled workshop session with QR attendance token.",
      "type": "object",
      "properties": {
        "workshopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workshopName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "sessionDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "qrToken": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["workshopId", "workshopName", "sessionDate", "startTime", "qrToken", "createdAt"]
    },
    "QrToken": {
      "title": "QrToken",
      "description": "Non-listable lookup record mapping a QR token to its workshop session.",
      "type": "object",
      "properties": {
        "workshopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workshopName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "sessionDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "startTime": {
          "type": "string",
          "maxLength": 5,
          "pattern": "^\\d{2}:\\d{2}$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["workshopId", "sessionId", "workshopName", "sessionDate", "startTime", "createdAt"]
    },
    "Registration": {
      "title": "Registration",
      "description": "Participant enrollment in a workshop.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "workshopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workshopName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "cancelled"]
        },
        "registeredAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "participantName", "workshopId", "workshopName", "status", "registeredAt"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Attendance record for a participant in a specific workshop session.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "workshopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "sessionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "registrationId": {
          "type": "string",
          "maxLength": 260,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "status": {
          "type": "string",
          "enum": ["present", "absent"]
        },
        "qrToken": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "markedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "participantName", "workshopId", "sessionId", "registrationId", "status", "markedAt"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "Participant rating and comments for a workshop.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "workshopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workshopName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "rating": {
          "type": "integer"
        },
        "comments": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "isPublic": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "authorName", "workshopId", "workshopName", "rating", "comments", "isPublic", "createdAt", "updatedAt"]
    },
    "Certificate": {
      "title": "Certificate",
      "description": "Issued completion certificate verifiable by certificate code.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "workshopId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "workshopName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 140
        },
        "certificateCode": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^SC-[A-Z0-9]+$"
        },
        "issuedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "participantName", "workshopId", "workshopName", "certificateCode", "issuedAt"]
    }
  },
  "firestore": {
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/Admin" },
      "description": "Administrator role registry keyed by Firebase Auth UID."
    },
    "/users/{userId}/private/pii": {
      "schema": { "$ref": "#/entities/UserPii" },
      "description": "Owner-and-admin-only isolated participant PII document."
    },
    "/workshops/{workshopId}": {
      "schema": { "$ref": "#/entities/Workshop" },
      "description": "Publicly browsable community workshops catalog."
    },
    "/sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/Session" },
      "description": "Admin-managed workshop sessions containing QR tokens."
    },
    "/qrTokens/{token}": {
      "schema": { "$ref": "#/entities/QrToken" },
      "description": "Non-listable QR token lookup records for participant self check-in."
    },
    "/registrations/{registrationId}": {
      "schema": { "$ref": "#/entities/Registration" },
      "description": "Participant workshop registrations keyed by {userId}_{workshopId}."
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/Attendance" },
      "description": "Session attendance records keyed by {userId}_{sessionId}."
    },
    "/feedback/{feedbackId}": {
      "schema": { "$ref": "#/entities/Feedback" },
      "description": "Workshop ratings and feedback keyed by {userId}_{workshopId}."
    },
    "/certificates/{certificateCode}": {
      "schema": { "$ref": "#/entities/Certificate" },
      "description": "Completion certificates keyed by unique certificate code."
    }
  }
}
